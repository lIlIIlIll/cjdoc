{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cjdoc.local/schema/cfg-matrix.schema.json",
  "title": "cjdoc cfg matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "profiles"],
  "properties": {
    "schemaVersion": {"const": "cjdoc.cfg-matrix/1"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "cjdoc"},
        "version": {"type": "string"}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "documentation"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "documentation": {"$ref": "https://cjdoc.local/schema/doc-ir.schema.json"}
        }
      }
    }
  }
}
