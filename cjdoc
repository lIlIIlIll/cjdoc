#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
binary="${repo_root}/target/release/bin/main"
if [[ ! -x "${binary}" && ! -x "${binary}.exe" ]]; then
    (cd "${repo_root}" && cjpm build)
fi
if [[ ! -x "${binary}" && -x "${binary}.exe" ]]; then
    binary="${binary}.exe"
fi

exec "${binary}" "$@"
